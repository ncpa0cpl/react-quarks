{
  "name": "react-quarks",
  "version": "3.0.1",
  "description": "React state management library with async support.",
  "main": "./dist/legacy/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "repository": {
    "url": "https://github.com/ncpa0cpl/react-quarks"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test:unit": "vitest run",
    "test:lint": "oxlint .",
    "test:fmt:src": "dprint check ./src/**/*",
    "test:fmt:tests": "dprint check ./__tests__/**/*",
    "test:fmt": "yarn test:fmt:src && yarn test:fmt:tests",
    "test:tsc": "tsc --noEmit",
    "fix:fmt:src": "dprint fmt ./src/**/*",
    "fix:fmt:tests": "dprint fmt ./__tests__/**/*",
    "fix:fmt": "yarn fix:fmt:src && yarn fix:fmt:tests",
    "publish:canary": "npm version --no-git-tag-version --preid canary-$(git rev-parse HEAD) prerelease && npm publish --tag canary && git checkout .",
    "prepare": "husky install"
  },
  "author": "Bretner Szymon (ncpa0cpl)",
  "license": "MIT",
  "keywords": [
    "state",
    "management",
    "react",
    "async",
    "asynchronous",
    "promise"
  ],
  "peerDependencies": {
    "react": ">19.2.18"
  },
  "dependencies": {
    "immer": "^11.1.15",
    "lodash.clonedeep": "^4.5.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@ncpa0cpl/nodepack": "^2.4.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/luxon": "^3.7.3",
    "@types/node": "^22.2.0",
    "@types/react": "^19.2.18",
    "@types/serialize-javascript": "^5.0.4",
    "dprint": "^0.55.2",
    "esbuild": "^0.28.1",
    "git-hook-tasks": "git+https://github.com/ncpa0cpl/git-hook-tasks#2.0.1",
    "happy-dom": "^20.11.1",
    "husky": "^8.0.3",
    "oxlint": "^1.77.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-test-renderer": "^19.2.8",
    "serialize-javascript": "^7.0.7",
    "simple-git": "^3.36.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@1.22.19",
  "sideEffects": false
}
